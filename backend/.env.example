# === E-Cell DMCE Backend Environment Variables ===
# Copy this file to .env and fill in the values.

# Database connection string (PostgreSQL via Neon or local)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Admin credentials (created on first startup)
ADMIN_EMAIL=admin@ecell.com
ADMIN_PASSWORD=change-this-in-production

# JWT secret key
SECRET_KEY=change-this-to-a-random-secret

# Project name
PROJECT_NAME=E-Cell DMCE API

# CORS allowed origins (comma-separated)
# For production, list your frontend domains explicitly
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com,https://admin.yourdomain.com
